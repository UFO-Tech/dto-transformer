{
    "name": "ufo-tech/dto-transformer",
    "description": "The library provides tools for two-way transformation of DTO objects ⇄ arrays, respecting typing, contracts, and flexible transformation logic.",
    "license": "MIT",
    "authors": [
        {
            "name": "Alex Maistrenko",
            "email": "ashterix69@gmail.com"
        },
        {
            "name": "Valik Nikolaev",
            "email": "valiknik225@gmail.com"
        }
    ],
    "type": "library",
    "keywords": [
        "dto",
        "data transfer object",
        "value object",
        "transformer",
        "hydrator",
        "serializer",
        "deserializer",
        "array",
        "php",
        "json",
        "rpc",
        "symfony",
        "ufo"
    ],
    "homepage": "https://docs.ufo-tech.space/bin/view/docs/DTOTransformer/?language=en",
    "require": {
        "php": ">=8.4",
        "ext-intl": "*",
        "symfony/serializer": "^7.2|^8.0",
        "symfony/validator": "^7.2|^8.0",
        "symfony/cache-contracts": "^3.5",
        "phpdocumentor/type-resolver": "^1.10",
        "phpdocumentor/reflection-docblock": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Ufo\\DTO\\": "src/"
        },
        "files": [
            "aliases.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Ufo\\DTO\\Tests\\": "tests/",
            "Ufo\\DTO\\Benchmarks\\": "benchmarks/"
        }
    },
    "extra": {
    },
    "archive": {
        "exclude": [
            "/benchmarks",
            "/tests"
        ]
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "XDEBUG_MODE=coverage phpunit --coverage-text --coverage-html build/coverage --coverage-cobertura build/coverage/coverage.xml",
        "bench": "XDEBUG_MODE=off php benchmarks/run.php"
    }
  
}
