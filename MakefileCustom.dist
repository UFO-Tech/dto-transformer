
test: CMD = test
test: composer

phpunit: setup
	docker exec php_$(PROJECT_NAME) /bin/bash -c "XDEBUG_MODE=off php vendor/bin/phpunit --no-coverage $(ARGS)"

test-filter: ARGS = --filter $(FILTER)
test-filter: phpunit

debug-config: EXEC = debug:config
debug-config: symfony

sdk: EXEC = ufo:sdk:generate
sdk: symfony

sdk-vendor: EXEC = ufo:sdk:generate --vendor=$(VENDOR)
sdk-vendor: symfony
